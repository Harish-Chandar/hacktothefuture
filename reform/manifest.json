{
    "name": "Reform",
    "description": "Reformat Websites",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "hello.html",
        "default_icon": "icon.png"
    },
    "host_permissions": [
        "http://127.0.0.1:5000/*"
    ],
    "permissions": [
        "activeTab",
        "scripting"
    ]
}
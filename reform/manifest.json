{
    "name": "Reform",
    "description": "Reformat Websites",
    "version": "1.0",
    "manifest_version": 3,
    "minimum_chrome_version": "116",
    "action": {
        "default_icon": "icon.png",
        "default_title": "Open Reform"
    },
    "icons": {
        "128": "icon.png"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": ["sidePanel", "scripting", "storage", "unlimitedStorage"],
    "host_permissions": ["<all_urls>"]
}
